# ===================================================================
# SmartContractum — Конфигурация отправки реальных писем через SMTP
# ===================================================================

# 1. Пример настроек для Яндекс.Почты (smtp.yandex.ru):
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=ваш_логин@yandex.ru
# Создайте "Пароль приложения" в настройках безопасности Яндекса:
SMTP_PASSWORD=пароль_приложения_яндекс
SMTP_FROM_NAME=SmartContractum

# 2. Пример настроек для Mail.ru (smtp.mail.ru):
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=ваш_логин@mail.ru
# SMTP_PASSWORD=пароль_для_внешних_приложений_mailru
# SMTP_FROM_NAME=SmartContractum

# 3. Пример настроек для Gmail / Google Workspace (smtp.gmail.com):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=ваш_логин@gmail.com
# SMTP_PASSWORD=пароль_приложения_google
# SMTP_FROM_NAME=SmartContractum
