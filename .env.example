# ===================================================================
# SmartContractum — Конфигурация шлюза реальной отправки СМС
# ===================================================================

# Выберите провайдера: sms_ru | smsc
SMS_PROVIDER=sms_ru

# 1. Если используете SMS.RU (получить ключ на https://sms.ru/):
SMS_API_KEY=ВАШ_API_ID_ИЗ_SMS_RU

# 2. Если используете SMSC.RU (СМС-Центр, https://smsc.ru/):
# SMSC_LOGIN=ваш_логин
# SMSC_PASSWORD=ваш_пароль
